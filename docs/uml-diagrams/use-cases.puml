@startuml Pawthy_Use_Cases_Sprint2_SRS_20261120
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBorderColor #45676A
skinparam actorBorderColor #333333

actor "Pet Owner" as Owner
actor "Veterinarian / Administrator" as Vet
actor "Public Visitor" as Public

rectangle "Pawthy Pet Health Portal (proposed design)" {
 usecase "US-01 Provision Owner Account\n(Full Name + Phone, independent Owner ID)" as UC01
 usecase "US-02 Owner ID Login /\nChange Temporary Password" as UC02
 usecase "US-03 Enforce Role /\nRecord Ownership" as UC03
 usecase "US-04 Maintain Official Pet Profile" as UC04
 usecase "US-04 Manage Own Pet Gallery\nand Archive Own View" as UC04O
 usecase "US-05 Record / Edit Own Diary" as UC05
 usecase "US-06 View Diary History\nand Symptom Frequencies" as UC06
 usecase "US-07 Manage Clinical Records" as UC07
 usecase "US-07 Read Own Clinical Records" as UC07O
 usecase "US-08 View Medical Records\n(Sprint 1; missing SRS section)" as UC08
 usecase "US-09 Maintain Vaccination Records" as UC09
 usecase "US-10 View / Mark Read\nVaccination Reminders" as UC10
 usecase "US-11 Manage Weekly Hours\nand Date Exceptions" as UC11V
 usecase "US-11 View Available Intervals\n(Read Only)" as UC11O
 usecase "US-12 Manage Manual Appointments\n(+ Confirm Out-of-Hours Warning)" as UC12V
 usecase "US-12 View Own Appointments\nand Change Notifications" as UC12O
 usecase "US-13 Select Light / Dark Mode" as UC13
 usecase "US-14 First Login Guided Tour\n(Optional, P2)" as UC14
 usecase "US-14 Replay Tour From Help" as UC14R
 usecase "View Clinic Contact Number" as UCC
}

